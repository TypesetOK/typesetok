{
  "name": "typesetok-monorepo",
  "version": "0.9.8",
  "private": true,
  "description": "TypesetOK (TOK) - Professional Hebrew Desktop Publishing System",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:ts": "tsc --build",
    "bundle:ui": "node scripts/bundle-ui.mjs",
    "build": "npm run build:ts && npm run bundle:ui",
    "package:desktop": "node scripts/build-desktop-bundle.mjs",
    "package:installer": "node scripts/build-installer.mjs",
    "test": "node --test test/frontend.test.mjs test/milestone_features.test.mjs",
    "start": "electron packages/tok-electron/dist/main.js",
    "perf:startup": "node scripts/measure-startup.mjs"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "esbuild": "^0.28.2",
    "rcedit": "^5.0.2",
    "typescript": "^5.4.0"
  }
}
